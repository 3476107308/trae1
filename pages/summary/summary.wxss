.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f0f2f5;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.nav-placeholder {
  width: 64rpx;
}

.month-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  padding: 28rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.nav-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
}

.nav-btn:active {
  background-color: #e8e8e8;
}

.nav-icon {
  font-size: 44rpx;
  color: #4a90e2;
  font-weight: bold;
}

.month-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.calendar-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 30rpx;
}

.week-header {
  display: flex;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

.calendar-grid {
  display: flex;
  flex-direction: column;
}

.week-row {
  display: flex;
}

.day-cell {
  flex: 1;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 12rpx;
  margin: 4rpx;
}

.day-cell.empty {
  background-color: transparent;
}

.day-cell.has-todo {
  background-color: #f0f7ff;
}

.day-cell:active {
  background-color: #e8f0fe;
}

.day-number {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.todo-info {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.todo-count {
  font-size: 20rpx;
  color: #4a90e2;
  font-weight: 500;
}

.completed-count {
  font-size: 20rpx;
  color: #67c23a;
  font-weight: 500;
  margin-left: 6rpx;
}

.legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  background-color: #f0f7ff;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.legend-text {
  font-size: 24rpx;
  color: #999;
}