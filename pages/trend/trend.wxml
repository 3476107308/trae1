<view class="container">
  <view class="header">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <text class="title">完成事项曲线</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{todayCompleted}}</text>
      <text class="stat-label">今日完成</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{averageCompleted}}</text>
      <text class="stat-label">7日平均</text>
    </view>
  </view>

  <view class="summary-card">
    <text class="summary-text">{{summary}}</text>
  </view>

  <view class="chart-card">
    <text class="chart-title">最近7天完成趋势</text>
    <view class="chart-container">
      <view class="y-axis">
        <text class="y-label">{{getMaxCount()}}</text>
        <text class="y-label">{{Math.round(getMaxCount()/2)}}</text>
        <text class="y-label">0</text>
      </view>
      <view class="chart-area">
        <view class="bars-container">
          <view wx:for="{{trendData}}" wx:key="date" class="bar-item">
            <view class="bar-wrapper">
              <view 
                class="bar" 
                style="height: {{getBarHeight(item.completedCount)}}%;"
              >
              </view>
            </view>
            <text class="bar-label">{{item.dayLabel}}</text>
          </view>
        </view>
        <canvas type="2d" canvas-id="lineChart" class="line-canvas"></canvas>
      </view>
    </view>
  </view>
</view>