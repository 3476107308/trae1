.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f0f2f5;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.nav-placeholder {
  width: 64rpx;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: linear-gradient(135deg, #4a90e2 0%, #3a7ac7 100%);
  padding: 40rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.3);
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.summary-card {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.summary-text {
  font-size: 30rpx;
  color: #666;
  line-height: 1.6;
}

.chart-card {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.chart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  display: block;
}

.chart-container {
  display: flex;
  height: 400rpx;
}

.y-axis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-right: 20rpx;
  width: 60rpx;
}

.y-label {
  font-size: 22rpx;
  color: #999;
  text-align: right;
}

.chart-area {
  flex: 1;
  position: relative;
  border-left: 2rpx solid #eee;
  border-bottom: 2rpx solid #eee;
}

.bars-container {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 100%;
  padding-bottom: 40rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar-wrapper {
  width: 40rpx;
  height: 320rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 36rpx;
  background: linear-gradient(180deg, #4a90e2 0%, #3a7ac7 100%);
  border-radius: 8rpx 8rpx 0 0;
  position: relative;
  min-height: 8rpx;
  transition: height 0.5s ease;
}

.bar-value {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: #4a90e2;
  font-weight: 600;
}

.bar-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
}

.line-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}