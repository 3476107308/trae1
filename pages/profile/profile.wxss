.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.content-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.section-block {
  margin-bottom: 40rpx;
}

.section-block:last-child {
  margin-bottom: 0;
}

.block-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a90e2;
  margin-bottom: 16rpx;
  display: block;
}

.block-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}

.back-btn {
  background-color: #4a90e2;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 30rpx;
}

.back-btn:active {
  background-color: #3a7ac7;
}