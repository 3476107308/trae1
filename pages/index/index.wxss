.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #4a90e2 0%, #3a7ac7 30%, #f0f2f5 30%);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.header-actions {
  display: flex;
  gap: 20rpx;
}

.action-link {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 12rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

.action-link:active {
  background-color: rgba(255, 255, 255, 0.3);
}

.date-section {
  margin-bottom: 30rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.view-mode-tabs {
  display: flex;
  margin-bottom: 20rpx;
  padding: 8rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.mode-tab.active {
  background: linear-gradient(135deg, #4a90e2 0%, #3a7ac7 100%);
  color: #fff;
}

.date-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f8f9fa;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.nav-btn:active {
  background-color: #e9ecef;
  transform: scale(0.95);
}

.nav-icon {
  font-size: 52rpx;
  color: #4a90e2;
  font-weight: 300;
}

.date-display {
  text-align: center;
  flex: 1;
  margin: 0 24rpx;
}

.current-date {
  font-size: 40rpx;
  color: #333;
  font-weight: 600;
  display: block;
}

.date-tip {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.input-section {
  display: flex;
  margin-bottom: 30rpx;
}

.todo-input {
  flex: 1;
  height: 88rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  background-color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.todo-input:focus {
  border-color: #4a90e2;
}

.add-btn {
  width: 160rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #3a7ac7 100%);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  margin-left: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 226, 0.35);
}

.add-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.list-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.section-group {
  margin-bottom: 24rpx;
}

.section-group:last-child {
  margin-bottom: 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #4a90e2 0%, #3a7ac7 100%);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.divider {
  height: 24rpx;
  background: linear-gradient(90deg, transparent 0%, #f0f0f0 20%, #f0f0f0 80%, transparent 100%);
  margin: 12rpx 0;
  border-radius: 12rpx;
}

.todo-list {
  min-height: 100rpx;
}

.todo-list.completed-list {
  opacity: 0.85;
}

.week-day-group {
  margin-bottom: 30rpx;
}

.week-day-group:last-child {
  margin-bottom: 0;
}

.week-day-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.week-day-label {
  font-size: 28rpx;
  color: #4a90e2;
  font-weight: 600;
  margin-right: 16rpx;
}

.week-day-date {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}

.week-day-count {
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 16rpx;
  background-color: #e8eef5;
  border-radius: 16rpx;
}

.week-empty {
  padding: 40rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #ccc;
}

.week-todo-list {
  padding-left: 20rpx;
}

.empty-tip {
  color: #999;
  font-size: 28rpx;
  text-align: center;
  display: block;
  padding: 48rpx 0;
}

.loading-tip {
  padding: 60rpx 0;
  text-align: center;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  transition: all 0.2s ease;
}

.todo-item:last-child {
  border-bottom: none;
}

.todo-item:active {
  background-color: #fafafa;
  padding-left: 10rpx;
}

.priority-bar {
  width: 4rpx;
  height: 48rpx;
  border-radius: 2rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.priority-P1 {
  background-color: #e74c3c;
}

.priority-P2 {
  background-color: #f39c12;
}

.priority-P3 {
  background-color: #999;
}

.todo-status {
  margin-right: 24rpx;
  flex-shrink: 0;
}

.status-icon {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid #4a90e2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.status-icon.completed {
  background: #4caf50;
  border-color: #4caf50;
  transform: scale(1.1);
}

.check-icon {
  color: #fff;
  font-size: 14rpx;
  font-weight: bold;
}

.todo-title {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  transition: all 0.3s ease;
  line-height: 1.5;
}

.todo-title.completed {
  color: #999;
  text-decoration: line-through;
}

.todo-edit {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.edit-icon {
  font-size: 36rpx;
  color: #ccc;
  font-weight: bold;
}

.detail-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.detail-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 20rpx 20rpx 0 0;
  max-height: 85vh;
  z-index: 1001;
  animation: slideUp 0.3s ease-out;
  overflow-y: auto;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.panel-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel-back .back-icon {
  font-size: 48rpx;
  color: #333;
}

.panel-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.panel-save {
  padding: 12rpx 30rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #3a7ac7 100%);
  border-radius: 30rpx;
}

.save-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.panel-content {
  padding: 30rpx;
  max-height: calc(85vh - 100rpx);
  overflow-y: auto;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #4a90e2;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.form-textarea:focus {
  border-color: #4a90e2;
}

.options-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.option-btn {
  padding: 16rpx 28rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s ease;
}

.option-btn.selected {
  background: linear-gradient(135deg, #4a90e2 0%, #3a7ac7 100%);
  color: #fff;
}

.subtask-placeholder {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  border: 2rpx dashed #e0e0e0;
}

.placeholder-text {
  font-size: 28rpx;
  color: #999;
}

.add-subtask {
  font-size: 28rpx;
  color: #4a90e2;
}

.subtask-progress {
  font-size: 26rpx;
  color: #4a90e2;
  font-weight: 500;
}

.subtask-input-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.subtask-input {
  flex: 1;
  height: 72rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.subtask-input:focus {
  border-color: #4a90e2;
}

.subtask-input-actions {
  display: flex;
  gap: 16rpx;
  margin-left: 16rpx;
}

.subtask-btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.subtask-btn.confirm {
  background-color: #4a90e2;
  color: #fff;
}

.subtask-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.subtask-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.subtask-item:last-child {
  border-bottom: none;
}

.subtask-status {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.subtask-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.subtask-checkbox.checked {
  background-color: #4caf50;
  border-color: #4caf50;
}

.subtask-title {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.subtask-title.completed {
  color: #999;
  text-decoration: line-through;
}

.subtask-delete {
  padding: 8rpx 16rpx;
  color: #ff6b6b;
  font-size: 24rpx;
}

.subtask-empty {
  padding: 40rpx;
  text-align: center;
  background-color: #fafafa;
  border-radius: 12rpx;
  border: 2rpx dashed #e0e0e0;
}

.subtask-add {
  margin-top: 20rpx;
  padding: 20rpx;
  text-align: center;
  background-color: #f5f8fc;
  border-radius: 12rpx;
}